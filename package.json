{
  "name": "studyharder",
  "version": "0.2.0",
  "private": true,
  "description": "A lightweight, local-first study time-lapse recorder",
  "scripts": {
    "start": "python3 -m http.server 4173 --directory dist",
    "test": "playwright test",
    "check": "node --check dist/app.js",
    "build": "npm run check",
    "dev:cloudflare": "wrangler dev",
    "deploy:check": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "wrangler": "^4.152.0"
  },
  "overrides": {
    "undici": "^7.30.1"
  }
}
